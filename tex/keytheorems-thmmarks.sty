% now handle nested theorems (but not recommended)
\addtotheoremhook{prefoot}
  {
    \bool_if:NT \l__keythms_thmmarks_qedthm_bool
      {
        \mode_if_horizontal:T
          {
            \dim_compare:nNnT { \lastskip } > { 0pt }
              { \int_gincr:N \g__keythms_thmmarks_envwithin_int }
          }
        \cs_if_exist:cT
          {
            keythms_thmmark
            _ \int_use:N \g__keythms_thmmarks_absthm_int
            _ \int_use:N \g__keythms_thmmarks_envwithin_int
          }
          { \qedhere }
      }
  }
